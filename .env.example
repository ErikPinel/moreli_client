# Local development; .env.production supplies the deployed API for production builds.
VITE_API_URL=http://localhost:5146/api
# Use the existing pk_test_ key for the initial deployment; switch to pk_live_ later.
# This is public configuration only; never add server secrets.
VITE_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
VITE_ENABLE_QUERY_DEVTOOLS=false
# Build-only setting; .env.production explicitly opts in for the initial deployment.
# Override to false in Vercel when production Clerk is ready.
CLERK_ALLOW_DEVELOPMENT_INSTANCE=false