{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/sitemap-teachers.xml", "destination": "https://more-li-backend.vercel.app/api/seo/teachers.xml" },
    { "source": "/((?![^/]+\\.[^/]+$|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ]
  }, {
    "source": "/(robots\\.txt|llms\\.txt|ai\\.txt)",
    "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
  }, {
    "source": "/(sitemap.xml|sitemap-pages.xml)",
    "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
  }, {
    "source": "/(admin|student|teacher|auth|login|signup|match|terms|privacy)(/.*)?",
    "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
  }, {
    "source": "/support/:id",
    "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
  }]
}