# Public build defaults only. Set the Clerk publishable key in Vercel.
VITE_API_URL=https://more-li-backend.vercel.app/api
VITE_ENABLE_QUERY_DEVTOOLS=false
# Temporary build-only opt-in for the initial deployment with the existing test instance.
# Override to false in Vercel when switching to a production Clerk instance.
CLERK_ALLOW_DEVELOPMENT_INSTANCE=true
